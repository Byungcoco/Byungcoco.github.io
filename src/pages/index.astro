---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile, stack, projects, games, GAMES_TOP } from '../data/site';
import { noteSeries } from '../data/notes';
import { thumbOf } from '../lib/preview';

const reviews = (await getCollection('reviews')).sort((a, b) => a.data.order - b.data.order);
const notes = await getCollection('notes');
const noteGroups = noteSeries.map((s) => {
  const list = notes.filter((n) => n.data.series === s.key).sort((a, b) => a.data.order - b.data.order);
  const thumb = list.map((n) => thumbOf(n.body, n.data.thumb)).find(Boolean);
  return { ...s, count: list.length, thumb };
});
const firstReview = (key: string) => reviews.find((r) => r.data.project === key);
---
<Base title="강병준 · 게임 클라이언트 프로그래머">
<div class="page" id="page">
<nav class="toc" aria-label="섹션 이동">
  <a class="navlink on" href="#about"><span class="lbl">소개</span><span class="ln"></span></a>
  <a class="navlink" href="#career"><span class="lbl">경력</span><span class="ln"></span></a>
  <a class="navlink" href="#projects"><span class="lbl">학습 프로젝트</span><span class="ln"></span></a>
  <a class="navlink" href="#notes"><span class="lbl">학습 노트</span><span class="ln"></span></a>
  <a class="navlink" href="#play"><span class="lbl">플레이 로그</span><span class="ln"></span></a>
</nav>
<div class="wrap">

<header class="left">
  <div class="intro">
    <h1 class="name"><a href="/">{profile.name}</a></h1>
    <p class="title">{profile.title}</p>
    <p class="tagline">{profile.tagline}</p>
  </div>
  <section class="stack" aria-label="기술 스택">
    <h2 class="stackh">기술 스택</h2>
    {stack.map((g) => (
      <div class="sg"><span class="sgk">{g.group}</span><span class="chips">{g.items.map((i) => <span class="chip">{i}</span>)}</span></div>
    ))}
  </section>
  <ul class="contact" aria-label="연락처">
    <li><a href={profile.github} target="_blank" rel="noopener">GitHub ↗</a></li>
    <li><a href={`mailto:${profile.email}`}>{profile.email} ↗</a></li>
    <li><a href={profile.techDoc} target="_blank" rel="noopener">기술 문서 PDF ↗</a></li>
  </ul>
</header>

<main class="right">

<section id="about" aria-label="소개" class="sec">
  <h2 class="sechead">소개</h2>
  <div class="about">
    <p>
      학부시절 프로젝트에서 소프트웨어를 담당하며 <span class="em">작성한 코드가 실제 장치의 동작으로 이어지는 과정</span>에 흥미를 느꼈습니다.
      이후 Unity와 C#으로 메타버스 콘텐츠를 개발하며 실무를 경험했고,
      게임이 동작하는 원리를 더 깊이 이해하고 싶어 C++과 DirectX 11로 직접 게임 엔진을 만들기 시작했습니다.
    </p>

    <p>
      좋아하는 게임은 플레이하는 데서 그치지 않고, 직접 구현해 보기도 했습니다.
      <span class="em">카타나 제로의 리플레이, 뮬렛 매드잭의 속도감 있는 전투,
      듀엣 나이트 어비스의 전투와 연출</span>처럼 인상 깊었던 요소들을 하나씩 구현하면서,
      화면 속 경험이 어떤 코드와 시스템으로 만들어지는지 탐구했습니다.
    </p>

    <p>
      이 과정에서 <span class="em">이벤트 전달과 오브젝트의 생명주기, 충돌 처리</span> 등을
      직접 설계하고 구현했습니다.
      반복되는 작업은 툴로 만들고, 그 결과물을 게임에서 활용할 수 있도록 연결했습니다.
      프로젝트가 끝난 뒤에도 코드를 다시 살펴보며,
      아쉬웠던 구조는 다음 프로젝트에서 개선해 왔습니다.
    </p>
  </div>
</section>

<section id="career" aria-label="경력" class="sec">
  <h2 class="sechead">경력</h2>
  <h3 class="subhead">경력</h3>
  <div class="entry">
    <span class="side"><span>2022.02</span><span>~2023.02 (1년)</span></span>
    <div class="main">
      <span class="etitle">(주)휴트리온</span>
      <span class="role">사원 · Unity 기반 메타버스 솔루션 개발</span>
      <span class="shots">
        <img src="/img/career/editor.jpg" alt="메타버스 월드 에디터 화면" loading="lazy" />
        <img src="/img/career/custom.jpg" alt="캐릭터 의상 커스터마이징 화면" loading="lazy" />
      </span>
      <ul class="cl">
        <li><span class="em">메타버스 월드 에디터 솔루션</span> <span class="dim">· 2022.02 ~ 2023.02 · 5인</span><br />오브젝트 풀링 기반 무한 스크롤 에셋 목록, 오브젝트 배치 패널·우클릭 컨텍스트 메뉴, 의상 텍스처 합성 커스터마이징 구현. MySQL 저장·복원 데이터 정합성 검증.</li>
        <li><span class="em">K-Varam Virtual Office</span> <span class="dim">· 2022.07 ~ 2023.02 · KT DS 협업 약 20인</span><br />하우징(My Room) 콘텐츠의 가구 배치·저장·복원 전 과정 구현, Addressable로 카테고리별 리소스 그룹 설계, 요구사항 반영과 일정 조율.</li>
      </ul>
      <span class="tags"><span class="pill">Unity</span><span class="pill">C#</span><span class="pill">MySQL</span></span>
      <span class="acts"><a class="act" href="https://youtu.be/vfn2Gnf1htU?si=WFs7QPvrgL1Ruu0D" target="_blank" rel="noopener" aria-label="휴트리온 메타버스 솔루션 시연 영상 (YouTube)"><Icon name="youtube" /></a></span>
    </div>
  </div>
</section>

<section id="projects" aria-label="학습 프로젝트" class="sec">
  <h2 class="sechead">학습 프로젝트</h2>
  <h3 class="subhead">학습 프로젝트</h3>
  <ol class="plist">
    {projects.map((p) => {
      const r = firstReview(p.key);
      return (
        <li class="entry">
          <span class="side"><span>{p.start}</span><span>~{p.end} ({p.dur})</span><span class="team">{p.team}</span></span>
          <div class="main">
            <span class="ptitle"><span class="etitle">{p.name}</span><span class="genre">{p.genre}</span></span>
            <span class="role">{p.lead && <><strong class="lead">팀장</strong> </>}{p.roleText}</span>
            <img class="thumb" src={p.thumb} alt={`${p.name} 플레이 화면`} loading="lazy" />
            <span class="desc">{p.desc}</span>
            <span class="tags">{p.tags.map((t) => <span class="pill">{t}</span>)}</span>
            {r && <a class="review" href={`/reviews/${p.key}/`}>코드 리뷰 보기 <span aria-hidden="true">→</span></a>}
            <span class="acts">
              <a class="act" href={p.yt} target="_blank" rel="noopener" aria-label={`${p.name} 플레이 영상 (YouTube)`}><Icon name="youtube" /></a>
              <a class="act" href={p.gh} target="_blank" rel="noopener" aria-label={`${p.name} 소스 코드 (GitHub)`}><Icon name="github" /></a>
            </span>
          </div>
        </li>
      );
    })}
  </ol>
</section>

<section id="notes" aria-label="학습 노트" class="sec">
  <h2 class="sechead">학습 노트</h2>
  <h3 class="subhead">학습 노트</h3>
  <p class="lede">강의와 책, 샘플 프로젝트를 따라가며 직접 구현하고 정리한 기록입니다.</p>
  <div class="notes">
    {noteGroups.map((g) => (
      <a class="note" href={`/notes/${g.key}/`}>
        <span class="nth">{g.thumb && <img src={g.thumb} alt="" loading="lazy" />}</span>
        <span class="nhead"><span class="nname">{g.name}</span><span class="pill gb">{g.count}편</span></span>
        <span class="ndesc">{g.desc}</span>
      </a>
    ))}
  </div>
  <a class="review" href="/notes/">학습 노트 전체 보기 <span aria-hidden="true">→</span></a>
</section>

<section id="play" aria-label="플레이 로그" class="sec last">
  <h2 class="sechead">플레이 로그</h2>
  <h3 class="subhead">플레이 로그</h3>
  <p class="lede">오래, 깊게 파고든 게임들입니다.</p>
  <div class="games" id="games">
    {games.map((g, i) => (
      <div class={`game${i >= GAMES_TOP ? ' more' : ''}`}>
        <span class="gin">
          <span class="gt"><span class="gname">{g.title}</span><span class="pill gb">{g.badge}</span></span>
          <span class="gmeta">{g.meta}</span>
          {g.note && <span class="gnote">{g.note}</span>}
        </span>
      </div>
    ))}
  </div>
  <button type="button" class="toggle" id="gtoggle" aria-expanded="false" data-more={`${games.length - GAMES_TOP}개 더 보기 ↓`}>{games.length - GAMES_TOP}개 더 보기 ↓</button>
</section>

<footer class="foot">Design direction inspired by <a href="https://brittanychiang.com/" target="_blank" rel="noopener">Brittany Chiang</a>. Layout and code independently created.</footer>

</main>
</div>
</div>

<script>
  // 마우스를 따라오는 은은한 조명
  const page = document.getElementById('page')!;
  if (window.matchMedia('(pointer: fine)').matches) {
    window.addEventListener('mousemove', (e) => {
      page.style.setProperty('--x', e.clientX + 'px');
      page.style.setProperty('--y', e.clientY + 'px');
    }, { passive: true });
  }

  // 플레이 로그 펼치기 / 접기
  const games = document.getElementById('games')!;
  const btn = document.getElementById('gtoggle') as HTMLButtonElement;
  btn.addEventListener('click', () => {
    const open = games.classList.toggle('all');
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? '접기 ↑' : btn.dataset.more!;
  });

  // 스크롤 위치에 맞춰 왼쪽 메뉴 강조
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.navlink')];
  const secs = links.map((a) => document.querySelector(a.getAttribute('href')!)!);
  const onScroll = () => {
    const y = window.scrollY + window.innerHeight * 0.5; // 화면 가운데를 기준으로
    let cur = 0;
    secs.forEach((s, i) => { if ((s as HTMLElement).offsetTop <= y) cur = i; });
    links.forEach((a, i) => a.classList.toggle('on', i === cur));
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .page { --x: 300px; --y: 240px; min-height: 100vh; background: radial-gradient(600px at var(--x) var(--y), rgba(29,78,216,0.16), transparent 80%), #0A1628; background-attachment: fixed; }
  .wrap { max-width: 1280px; margin: 0 auto; padding: 0 56px 0 48px; box-sizing: border-box; display: flex; gap: 64px; }
  .left { flex: 0 0 30%; position: sticky; top: 0; height: 100vh; max-height: 1000px; overflow-y: auto; box-sizing: border-box; padding: 72px 0; display: flex; flex-direction: column; justify-content: space-between; }
  .right { flex: 1 1 auto; min-width: 0; padding: 96px 0; }
  .intro { display: flex; flex-direction: column; gap: 14px; }
  .name { margin: 0; font-size: 48px; line-height: 1.15; font-weight: 700; letter-spacing: -0.03em; color: #F4F6F9; }
  .name a { text-decoration: none; }
  .title { margin: 0; font-size: 20px; font-weight: 500; color: #F4F6F9; }
  .tagline { margin: 4px 0 0; max-width: 360px; }
  .toc { position: fixed; right: 24px; top: 50%; transform: translateY(-50%); z-index: 6; display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
  .navlink { display: flex; align-items: center; justify-content: flex-end; gap: 12px; min-height: 30px; text-decoration: none; color: #A3ADBF; font-size: 13px; font-weight: 600; transition: color .15s, font-size .15s; }
  .navlink .ln { display: block; width: 16px; height: 2px; border-radius: 2px; background: #3A4A68; transition: width .15s, background .15s; }
  .navlink .lbl { white-space: nowrap; }
  .navlink:hover { color: #F4F6F9; }
  .navlink.on { color: #7FB2FF; font-size: 15.5px; font-weight: 700; }
  .navlink.on .ln { width: 32px; height: 3px; background: #7FB2FF; }
  .navlink:hover .ln { width: 24px; background: #F4F6F9; }
  .stack { margin-top: 40px; display: flex; flex-direction: column; gap: 14px; }
  .stackh { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; color: #F4F6F9; }
  .sg { display: flex; flex-direction: column; gap: 6px; }
  .sgk { font-size: 12px; font-weight: 600; color: #A3ADBF; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .contact { margin: 32px 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 24px; font-size: 14px; font-weight: 600; }
  .contact a { text-decoration: none; color: #CDD5E1; }
  .contact a:hover { color: #7FB2FF; }

  .sec { margin-bottom: 112px; }
  .sec.last { margin-bottom: 96px; }
  .about { display: flex; flex-direction: column; gap: 18px; }
  .about p { margin: 0; }
  .em { color: #FFFFFF; font-weight: 700; font-size: 1.06em; }
  .dim { color: #A3ADBF; }
  .subhead { margin: 0 0 28px; font-size: 28px; line-height: 1.3; font-weight: 700; letter-spacing: -0.02em; color: #F4F6F9; }
  .sechead { display: none; }

  .entry { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 16px; padding: 20px 24px; margin: 0 -24px; transition: background .15s; }
  .entry:hover { background: rgba(127,178,255,0.06); box-shadow: inset 0 1px 0 rgba(148,163,184,0.1); }
  .entry:hover .etitle { color: #7FB2FF; }
  .side { grid-column: span 2; display: flex; flex-direction: column; gap: 2px; padding-top: 3px; font-size: 14px; line-height: 1.5; font-weight: 600; color: #A3ADBF; }
  .team { margin-top: 6px; font-size: 13px; font-weight: 500; }
  .main { grid-column: span 6; display: flex; flex-direction: column; gap: 10px; }
  .etitle { font-size: 18px; font-weight: 600; color: #F4F6F9; }
  .ptitle { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .genre { font-size: 13px; font-weight: 500; color: #A3ADBF; }
  .role { font-size: 14px; color: #D8DEE7; }
  .lead { font-weight: 700; color: #7FB2FF; }
  .shots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 6px 0 2px; }
  .shots img, .thumb { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border: 2px solid #1E3150; box-sizing: border-box; background: #13233F; }
  .thumb { margin: 6px 0; }
  .cl { margin: 4px 0 0; padding: 0 0 0 18px; display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
  .desc { font-size: 15px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .plist { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 48px; }
  .review { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; margin-top: 8px; padding: 10px 18px; border: 1px solid rgba(127,178,255,0.5); border-radius: 8px; font-size: 20px; font-weight: 600; color: #7FB2FF; text-decoration: none; }
  .review:hover { background: rgba(127,178,255,0.12); border-color: #7FB2FF; text-decoration: underline; }
  .acts { display: flex; align-items: center; gap: 8px; margin-left: -8px; }
  .act { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; height: 44px; text-decoration: none; }

  .lede { margin: 0 0 24px; font-size: 15px; }
  .games { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
  .game { display: flex; gap: 16px; padding: 16px; background: rgba(19,35,63,0.6); }
  .game:hover { background: rgba(127,178,255,0.08); }
  .game.more { display: none; }
  .games.all .game.more { display: flex; }
  .gin { min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .gt { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .gname { font-size: 15px; font-weight: 600; color: #F4F6F9; }
  .gb { padding: 2px 8px; font-size: 11px; }
  .gmeta { font-size: 12px; color: #A3ADBF; }
  .gnote { font-size: 13px; line-height: 1.6; }
  .toggle { margin-top: 16px; min-height: 44px; padding: 0 4px; background: none; border: 0; cursor: pointer; font-family: inherit; font-size: 14px; font-weight: 600; color: #7FB2FF; }
  .notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin-bottom: 8px; }
  .nth { display: block; aspect-ratio: 16 / 9; margin-bottom: 6px; overflow: hidden; border-radius: 6px; border: 1px solid #1E3150; background: #13233F; }
  .nth img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: left top; }
  .note { display: flex; flex-direction: column; gap: 6px; padding: 16px; background: rgba(19,35,63,0.6); text-decoration: none; color: #CDD5E1; }
  .note:hover { background: rgba(127,178,255,0.08); }
  .note:hover .nname { color: #7FB2FF; }
  .nhead { display: flex; align-items: center; gap: 8px; }
  .nname { font-size: 16px; font-weight: 600; color: #F4F6F9; }
  .ndesc { font-size: 14px; line-height: 1.6; }
  .nmeta { font-size: 12px; color: #A3ADBF; }
  .foot { max-width: 440px; font-size: 13px; color: #A3ADBF; }
  .foot a { color: #D8DEE7; font-weight: 600; text-decoration: none; }
  .foot a:hover { color: #7FB2FF; }

  /* PC에서 글자 1~2px 크게 */
  @media (min-width: 1024px) {
    .title { font-size: 21px; }
    .stackh, .sgk { font-size: 13px; }
    .contact { font-size: 15px; }
    .navlink { font-size: 14px; }
    .navlink.on { font-size: 16.5px; }
    .right { padding-right: 150px; }
    .side { font-size: 15px; }
    .team { font-size: 14px; }
    .etitle { font-size: 19px; }
    .genre { font-size: 14px; }
    .role { font-size: 15px; }
    .cl, .desc, .lede { font-size: 16px; }
    .review { font-size: 21px; }
    .gname { font-size: 16px; }
    .gb { font-size: 12px; }
    .gmeta { font-size: 13px; }
    .gnote { font-size: 14px; }
    .toggle { font-size: 15px; }
    .foot { font-size: 14px; }
    .subhead { font-size: 30px; }
  }
  @media (max-width: 1023px) {
    .wrap { flex-direction: column; padding: 0 24px; gap: 0; }
    .left { position: static; height: auto; max-height: none; padding: 64px 0 24px; }
    .toc { display: none; }
    .name { font-size: 38px; }
    .title { font-size: 18px; }
    .right { padding: 24px 0 64px; }
    .sec { margin-bottom: 64px; }
    .subhead { display: none; }
    .sechead { display: block; position: sticky; top: 0; z-index: 2; margin: 0 -24px 16px; padding: 16px 24px; background: rgba(10,22,40,0.92); color: #F4F6F9; font-size: 24px; line-height: 1.3; font-weight: 700; letter-spacing: -0.02em; }
    .entry { margin: 0; padding: 16px 0; }
    .entry:hover { background: transparent; box-shadow: none; }
    .side, .main { grid-column: span 8; }
    .side { flex-direction: row; flex-wrap: wrap; gap: 6px; }
    .team { margin-top: 0; }
    .team::before { content: '· '; }
    .games { grid-template-columns: minmax(0, 1fr); }
  }
</style>
</Base>
