---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { projects } from '../../data/site';

export async function getStaticPaths() {
  const all = await getCollection('reviews');
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const project = projects.find((p) => p.key === entry.data.project)!;
const siblings = (await getCollection('reviews', (r) => r.data.project === entry.data.project))
  .sort((a, b) => a.data.order - b.data.order);
const idx = siblings.findIndex((r) => r.id === entry.id);
const href = (r: { id: string }) => `/reviews/${r.id}/`;
const allReviews = await getCollection('reviews');
const lineage = [entry.data.lineage ?? []].flat().map((l) => {
  const t = allReviews.find((r) => href(r) === l.href);
  const pn = t && projects.find((p) => p.key === t.data.project)!.name;
  return { href: t ? l.href : undefined, label: t ? `${pn} — ${t.data.title}` : l.label };
});
const items = siblings.map((r) => ({ href: href(r), title: r.data.title, topic: r.data.topic }));
---
<Article pageTitle={`${entry.data.title} · ${project.name} 코드 리뷰`} title={entry.data.title} crumb={`${project.name} · 코드 리뷰`} section="reviews" active={project.key} siblings={items} idx={idx} headings={headings} lineage={lineage}>
  <Content />
</Article>
