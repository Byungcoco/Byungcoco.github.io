---
interface Props { title: string; description?: string }
const { title, description = '강병준 · 게임 클라이언트 프로그래머 포트폴리오' } = Astro.props;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0A1628" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style is:global>
    html { scroll-behavior: smooth; }
    body { margin: 0; background: #0A1628; color: #CDD5E1; font-family: 'IBM Plex Sans KR', sans-serif; font-size: 16px; line-height: 1.75; -webkit-font-smoothing: antialiased; }
    a { color: #F4F6F9; }
    a:hover { color: #7FB2FF; }
    .chip { display: inline-block; padding: 3px 9px; border: 1px solid #24385A; border-radius: 4px; font-size: 12px; font-weight: 500; line-height: 1.5; color: #D8DEE7; }
    .pill { background: rgba(127,178,255,0.1); color: #7FB2FF; font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 999px; line-height: 1.5; }
    @media (min-width: 1024px) {
      body { font-size: 17px; }
      .chip { font-size: 13px; }
      .pill { font-size: 13px; }
    }
    :focus-visible { outline: 2px solid #7FB2FF; outline-offset: 2px; }
  </style>
</head>
<body>
  <slot />
</body>
</html>
