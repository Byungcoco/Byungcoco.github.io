---
// 블로그형 목록: 왼쪽 사이드바 + 썸네일 카드 (학습 노트·코드 리뷰 공통)
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
interface Card { href: string; title: string; meta: string; summary?: string; thumb?: string; badge?: string }
interface Props { pageTitle: string; heading: string; desc?: string; section: 'notes' | 'reviews'; active?: string; cards: Card[] }
const { pageTitle, heading, desc, section, active, cards } = Astro.props;
---
<Base title={pageTitle}>
<Sidebar section={section} active={active} />
<div class="lay">
  <main class="main">
    <h1>{heading}</h1>
    {desc && <p class="desc">{desc}</p>}
    <ol class="cards">
      {cards.map((c) => (
        <li>
          <a class="card" href={c.href}>
            <span class="th">{c.thumb ? <img src={c.thumb} alt="" loading="lazy" /> : <span class="noth">{c.title}</span>}</span>
            <span class="tx">
              <span class="meta">{c.badge && <span class="badge">{c.badge}</span>}{c.meta}</span>
              <span class="ct">{c.title}</span>
              {c.summary && <span class="sum">{c.summary}</span>}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</div>
<style>
  .lay { max-width: 1040px; margin: 0 auto; padding: 56px 48px 96px; box-sizing: border-box; }
  @media (min-width: 1024px) { .lay { margin-left: max(248px, calc((100vw - 1040px) / 2 + 124px)); } }
  .main h1 { margin: 0 0 8px; font-size: 30px; font-weight: 700; letter-spacing: -0.02em; color: #F4F6F9; }
  .desc { margin: 0 0 28px; font-size: 16px; }
  .cards { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
  .card { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 22px; padding: 16px; border-radius: 10px; text-decoration: none; color: #CDD5E1; }
  .card:hover { background: rgba(127,178,255,0.06); }
  .card:hover .ct { color: #7FB2FF; }
  .th { display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 8px; border: 1px solid #1E3150; background: #13233F; }
  .th img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: left top; }
  .noth { display: flex; align-items: center; justify-content: center; height: 100%; padding: 12px; box-sizing: border-box; font-size: 15px; font-weight: 700; color: #7FB2FF; text-align: center; }
  .tx { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .meta { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #A3ADBF; }
  .badge { padding: 1px 8px; border-radius: 999px; background: rgba(127,178,255,0.1); color: #7FB2FF; font-size: 12px; font-weight: 600; }
  .ct { font-size: 19px; font-weight: 700; line-height: 1.4; color: #F4F6F9; }
  .sum { font-size: 15px; line-height: 1.65; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 900px) {
    .lay { padding: 32px 16px 96px; }
    .card { grid-template-columns: 120px minmax(0, 1fr); gap: 14px; padding: 12px 0; }
    .ct { font-size: 16px; }
    .sum { -webkit-line-clamp: 2; font-size: 14px; }
  }
</style>
</Base>
