---
// 코드 리뷰·학습 노트 공통 글 레이아웃
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
interface Item { href: string; title: string; topic?: string }
interface Props {
  pageTitle: string; title: string; crumb: string;
  siblings: Item[]; idx: number; headings: { depth: number; slug: string; text: string }[];
  lineage?: { href?: string; label: string }[]; lineageLabel?: string; meta?: string;
  section: 'notes' | 'reviews'; active: string;
}
const { pageTitle, title, crumb, siblings, idx, headings, lineage = [], lineageLabel = '개선 과정 · 이전 단계', meta, section, active } = Astro.props;
const prev = siblings[idx - 1];
const next = siblings[idx + 1];
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={pageTitle}>
<Sidebar section={section} active={active} current={siblings[idx].href} />
<div class="page">
<header class="top">
  <div class="topin">
    <div class="ttl">
      <span class="crumb">{crumb} {idx + 1} / {siblings.length}</span>
      <h1>{title}</h1>
    </div>
    <nav class="nav3" aria-label="글 이동">
      {prev ? <a class="nb" href={prev.href}><span class="nk"><span aria-hidden="true">←</span> 이전 글</span><span class="nt">{prev.title}</span></a>
            : <span class="nb off"><span class="nk">← 이전 글</span><span class="nt">처음 글입니다</span></span>}
      {next ? <a class="nb right" href={next.href}><span class="nk">다음 글 <span aria-hidden="true">→</span></span><span class="nt">{next.title}</span></a>
            : <span class="nb right off"><span class="nk">다음 글 →</span><span class="nt">마지막 글입니다</span></span>}
    </nav>
  </div>
</header>

<nav class="toc" aria-label="목차">
  {toc.map((h, i) => <a class={`ti${i === 0 ? ' on' : ''}`} href={`#${h.slug}`}><span class="lbl">{h.text}</span><span class="ln"></span></a>)}
</nav>

<main class="article" id="top">
  {meta && <p class="meta">{meta}</p>}
  <slot />
  {lineage.length > 0 && (
    <p class="lineage">{lineageLabel}: {lineage.map((l, i) => <>{i > 0 && <span class="sep"> · </span>}{l.href ? <a href={l.href}>{l.label}</a> : <span>{l.label}</span>}</>)}</p>
  )}
</main>
</div>

<div class="modal" id="modal" role="dialog" aria-modal="true" hidden>
  <button type="button" class="dimbg" data-close aria-label="미리보기 닫기"></button>
  <div class="mcard">
    <button type="button" class="mx" data-close aria-label="닫기">✕</button>
    <img id="mimg" alt="" />
    <span class="mcap"><strong id="mnum"></strong> <span id="mtext"></span></span>
  </div>
</div>

<script>
  // 탭
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
    const btns = [...box.querySelectorAll<HTMLButtonElement>(':scope > .tabbar > .tab')];
    const panels = [...box.querySelectorAll<HTMLElement>(':scope > .tabpanel')];
    const pick = (k: number) => {
      btns.forEach((b, i) => { b.classList.toggle('on', i === k); b.setAttribute('aria-selected', String(i === k)); });
      panels.forEach((p, i) => { p.hidden = i !== k; });
    };
    btns.forEach((b, i) => b.addEventListener('click', () => pick(i)));
    pick(0);
  });

  // 그림 미리보기
  const modal = document.getElementById('modal')!;
  const mimg = document.getElementById('mimg') as HTMLImageElement;
  const close = () => { modal.hidden = true; };
  document.querySelectorAll<HTMLButtonElement>('.fref, .figbtn').forEach((b) => b.addEventListener('click', () => {
    const fig = document.getElementById('fig-' + b.dataset.fig);
    if (!fig) return;
    const img = fig.querySelector('img')!;
    mimg.src = img.src; mimg.alt = img.alt;
    document.getElementById('mnum')!.textContent = `▲ 그림 ${fig.dataset.n}.`;
    document.getElementById('mtext')!.textContent = fig.dataset.cap ?? '';
    modal.setAttribute('aria-label', `그림 ${fig.dataset.n}`);
    modal.hidden = false;
    (modal.querySelector('.mx') as HTMLButtonElement).focus();
  }));
  modal.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', close));

  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

  // 오른쪽 목차 강조
  const tis = [...document.querySelectorAll<HTMLAnchorElement>('.ti')];
  const hs = tis.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))!);
  const onScroll = () => {
    const y = window.scrollY + window.innerHeight * 0.5; // 화면 가운데 기준
    let cur = 0;
    hs.forEach((h, i) => { if (h && h.getBoundingClientRect().top + window.scrollY <= y) cur = i; });
    tis.forEach((a, i) => a.classList.toggle('on', i === cur));
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style is:global>
  @media (min-width: 1024px) { .page { margin-left: 248px; } }
  .top { position: sticky; top: 0; z-index: 5; background: rgba(10,22,40,0.88); backdrop-filter: blur(8px); border-bottom: 1px solid #1E3150; }
  .topin { max-width: 1200px; margin: 0 auto; padding: 12px 48px; box-sizing: border-box; display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .ttl { flex: 1 1 240px; min-width: 0; display: flex; flex-direction: column; line-height: 1.35; }
  .crumb { font-size: 13px; font-weight: 600; color: #A3ADBF; }
  .ttl h1 { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.02em; color: #F4F6F9; }
  .nav3 { display: flex; align-items: stretch; gap: 8px; }
  .nb { display: flex; flex-direction: column; justify-content: center; gap: 2px; width: 170px; min-height: 52px; padding: 6px 14px; box-sizing: border-box; border: 1px solid #24385A; border-radius: 8px; background: transparent; text-decoration: none; font-family: inherit; color: #E4E8EF; cursor: pointer; }
  .nb:hover { border-color: #7FB2FF; background: rgba(127,178,255,0.08); }
  .nb.right { text-align: right; align-items: flex-end; }
  .nb.off { opacity: 0.45; cursor: default; }
  .nb.off:hover { border-color: #24385A; background: transparent; }
  .nk { font-size: 12px; font-weight: 600; color: #A3ADBF; line-height: 1.3; }
  .nt { font-size: 13px; font-weight: 600; color: #F4F6F9; line-height: 1.35; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }

  .toc { position: fixed; right: 20px; top: 50%; transform: translateY(-50%); z-index: 6; display: flex; flex-direction: column; align-items: flex-end; gap: 2px; padding: 10px 8px; }
  .ti { display: flex; align-items: center; justify-content: flex-end; gap: 12px; min-height: 30px; text-decoration: none; color: #A3ADBF; font-size: 13px; font-weight: 600; transition: color .15s, font-size .15s; }
  .ti .ln { flex: none; display: block; width: 16px; height: 2px; border-radius: 2px; background: #3A4A68; transition: width .15s, background .15s; }
  .ti.on { color: #7FB2FF; font-size: 15.5px; font-weight: 700; }
  .ti.on .ln { width: 32px; height: 3px; background: #7FB2FF; }
  .ti .lbl { max-width: 190px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .ti:hover { color: #F4F6F9; }
  .ti:hover .ln { width: 24px; background: #F4F6F9; }

  /* 본문 */
  .article { max-width: 1200px; margin: 0 auto; padding: 56px 96px 96px 48px; box-sizing: border-box; line-height: 1.8; }
  .article .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 18px 0; }
  .article h2 { margin: 96px 0 18px; font-size: 28px; line-height: 1.3; font-weight: 700; letter-spacing: -0.02em; color: #F4F6F9; scroll-margin-top: 96px; }
  .article h2:first-child { margin-top: 0; }
  .article h3 { margin: 26px 0 12px; font-size: 18px; font-weight: 600; color: #F4F6F9; scroll-margin-top: 96px; }
  .article h4 { margin: 30px 0 18px; font-size: 17px; font-weight: 600; color: #F4F6F9; }
  .article p { margin: 0 0 18px; }
  .article strong { color: #FFFFFF; font-weight: 700; font-size: 1.06em; }
  .article ul { margin: 0 0 18px; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }
  .article :not(pre) > code { font-family: 'IBM Plex Mono', monospace; font-size: 0.88em; padding: 1px 6px; background: #13233F; border-radius: 4px; color: #E4E8EF; }
  .article blockquote { margin: 0 0 18px; padding: 4px 0 4px 20px; border-left: 3px solid #7FB2FF; font-size: 17px; line-height: 1.8; color: #E4E8EF; }
  .article blockquote p { margin: 0; }
  .article table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .article th { text-align: left; padding: 12px 14px; background: #13233F; color: #F4F6F9; font-weight: 600; }
  .article td { padding: 12px 14px; border-top: 1px solid #1E3150; vertical-align: top; }
  .article tr.hl td { background: rgba(127,178,255,0.07); color: #F4F6F9; }
  .article td strong { font-weight: 700; }
  .article h2 strong, .article h3 strong, .article h4 strong, .fig figcaption strong, .summary strong, .mcap strong { font-size: inherit; }
  .tbl { overflow-x: auto; border: 1px solid #1E3150; border-radius: 8px; margin: 0 0 18px; }
  .cn { font-weight: 600; color: #F4F6F9; }

  .summary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; max-width: 640px; padding: 20px; margin: 0 0 18px; box-sizing: border-box; background: #0E1D35; border: 1px solid #1E3150; border-radius: 10px; }
  .summary .si { display: flex; flex-direction: column; gap: 4px; }
  .summary .sh { grid-column: 1 / -1; font-size: 13px; font-weight: 600; color: #F4F6F9; }
  .summary .k { font-size: 12px; font-weight: 600; color: #A3ADBF; }
  .summary .v { font-size: 26px; font-weight: 700; letter-spacing: -0.02em; color: #FF6B6B; line-height: 1.4; }
  .summary .s { font-size: 13px; color: #CDD5E1; }
  .summary .sf { grid-column: 1 / -1; padding-top: 10px; border-top: 1px solid #1E3150; font-size: 13px; color: #A3ADBF; }
  .summary .sf p { margin: 0; }
  .summary .sf strong { color: #A3ADBF; font-weight: 700; }

  .fig { margin: 0 0 18px; display: flex; flex-direction: column; gap: 10px; }
  .figw { display: block; padding: 14px; background: #FFFFFF; border-radius: 10px; }
  .figd { display: block; overflow: hidden; border: 1px solid #1E3150; border-radius: 10px; }
  .fig img { display: block; width: 100%; height: auto; }
  .figbtn { margin: 0; font: inherit; cursor: zoom-in; text-align: left; width: 100%; box-sizing: border-box; transition: box-shadow .15s; }
  button.figw { border: 0; }
  button.figd { padding: 0; background: transparent; }
  .figbtn:hover { box-shadow: 0 0 0 2px #7FB2FF; }
  .fig figcaption { font-size: 13px; color: #CDD5E1; line-height: 1.6; }
  .fig figcaption strong { font-weight: 700; color: #F4F6F9; }
  .fref { display: inline; margin: 0; padding: 0 2px; border: 0; border-bottom: 1px dashed #7FB2FF; background: none; font-family: inherit; font-size: inherit; font-weight: 700; color: #7FB2FF; cursor: zoom-in; }
  .fref:hover { background: rgba(127,178,255,0.14); }

  .tabbar { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 18px; }
  .tab { min-height: 44px; padding: 0 16px; border: 1px solid #24385A; border-radius: 8px; background: transparent; color: #CDD5E1; font-family: inherit; font-size: 14px; font-weight: 600; cursor: pointer; }
  .tab:hover { color: #F4F6F9; border-color: #3A5480; }
  .tab.on { background: rgba(127,178,255,0.12); border-color: #7FB2FF; color: #7FB2FF; cursor: default; }
  .tabpanel > :first-child { margin-top: 0; }

  .ed { margin: 0 0 18px; display: flex; flex-direction: column; border: 1px solid #2B2B2B; border-radius: 8px; overflow: hidden; background: #1E1E1E; }
  .ed + .ed { margin-top: -6px; }
  .edbar { display: flex; align-items: stretch; gap: 12px; background: #252526; border-bottom: 1px solid #2B2B2B; font-size: 12px; line-height: 1.4; }
  .edtab { display: flex; align-items: center; padding: 8px 14px; background: #1E1E1E; border-top: 2px solid #007ACC; color: #FFFFFF; font-family: 'IBM Plex Mono', monospace; }
  .edfn { display: flex; align-items: center; min-width: 0; color: #9DA5B4; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; padding-right: 12px; }
  .ed pre { margin: 0; padding: 16px 20px; overflow-x: auto; font-family: 'IBM Plex Mono', Consolas, monospace; font-size: 13px; line-height: 1.65; tab-size: 4; background-color: #1E1E1E !important; }

  .lineage { margin: 48px 0 0 !important; padding-top: 28px; border-top: 1px solid #1E3150; font-size: 14px; color: #A3ADBF; }
  .article > pre, .note-box pre, .tabpanel > pre { margin: 0 0 18px; padding: 16px 20px; border: 1px solid #2B2B2B; border-radius: 8px; overflow-x: auto; font-family: 'IBM Plex Mono', Consolas, monospace; font-size: 13px; line-height: 1.65; tab-size: 4; background-color: #1E1E1E !important; }
  .note-box { margin: 0 0 18px; padding: 16px 20px; background: #0E1D35; border: 1px solid #1E3150; border-left: 3px solid #7FB2FF; border-radius: 8px; }
  .note-box > :last-child { margin-bottom: 0; }
  .article p.cap { margin-top: -8px; font-size: 13.5px; color: #A3ADBF; }
  .meta { margin: 0 0 28px; font-size: 14px; color: #A3ADBF; }
  .meta a { color: #7FB2FF; text-decoration: none; }
  .lineage a { font-weight: 600; color: #7FB2FF; text-decoration: none; }

  .modal { position: fixed; inset: 0; z-index: 20; display: flex; align-items: center; justify-content: center; padding: 32px; box-sizing: border-box; }
  .modal[hidden] { display: none; }
  .dimbg { position: absolute; inset: 0; border: 0; padding: 0; margin: 0; background: rgba(5,12,24,0.78); cursor: zoom-out; }
  .mcard { position: relative; max-width: min(1400px, 96vw); max-height: 94vh; display: flex; flex-direction: column; gap: 10px; padding: 16px; background: #FFFFFF; border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
  .mcard img { display: block; max-width: 100%; max-height: 84vh; object-fit: contain; margin: 0 auto; }
  .mcap { font-size: 13px; line-height: 1.5; color: #3A4B6B; }
  .mcap strong { color: #0A1628; }
  .mx { position: absolute; top: -14px; right: -14px; width: 44px; height: 44px; border-radius: 999px; border: 0; background: #0A1628; color: #F4F6F9; font-size: 18px; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,0.4); }

  /* PC에서 글자 1~2px 크게 */
  @media (min-width: 1024px) {
    .crumb { font-size: 14px; }
    .ttl h1 { font-size: 24px; }
    .nk { font-size: 13px; }
    .nt { font-size: 14px; }
    .ti { font-size: 14px; }
    .ti.on { font-size: 16.5px; }
    .article { padding-right: 260px; }
    .article { font-size: 17.5px; }
    .article h2 { font-size: 30px; }
    .article h3 { font-size: 20px; }
    .article h4 { font-size: 18.5px; }
    .article blockquote { font-size: 18.5px; }
    .article table { font-size: 15.5px; }
    .summary .sh, .summary .s, .summary .sf { font-size: 14.5px; }
    .summary .k { font-size: 13px; }
    .summary .v { font-size: 28px; }
    .fig figcaption { font-size: 14.5px; }
    .tab { font-size: 15px; }
    .edbar { font-size: 13px; }
    .ed pre { font-size: 14.5px; }
    .lineage { font-size: 15px; }
    .mcap { font-size: 14.5px; }
  }
  @media (max-width: 1023px) {
    .top { position: static; }
    .topin { padding: 12px 16px; gap: 12px; }
    .nav3 { width: 100%; }
    .nb { flex: 1 1 0; width: auto; min-width: 0; }
    .article { padding: 28px 16px 64px; }
    .toc { display: none; }
    .summary { grid-template-columns: minmax(0, 1fr); }
  }
</style>
</Base>
