---
// 왼쪽 고정 사이드바 (목록·글 페이지 공통)
// section: 지금 보고 있는 메뉴, active: 강조할 카테고리 key, current: 지금 글 주소(있으면 그 카테고리 글 목록을 펼침)
import { getCollection } from 'astro:content';
import { noteSeries } from '../data/notes';
import { projects, profile } from '../data/site';
interface Props { section: 'notes' | 'reviews'; active?: string; current?: string }
const { section, active, current } = Astro.props;

const notes = await getCollection('notes');
const reviews = await getCollection('reviews');
const groups = [...new Set(noteSeries.map((s) => s.group))];

// 글 페이지면 그 카테고리의 글 목록
const posts = !current ? [] : section === 'notes'
  ? notes.filter((n) => n.data.series === active).sort((a, b) => a.data.order - b.data.order).map((n) => ({ href: `/notes/${n.id}/`, title: n.data.title }))
  : reviews.filter((r) => r.data.project === active).sort((a, b) => a.data.order - b.data.order).map((r) => ({ href: `/reviews/${r.id}/`, title: r.data.title }));
---
<header class="mbar">
  <button type="button" class="sbopen" id="sbopen" aria-label="메뉴 열기" aria-controls="sb" aria-expanded="false">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>
  <a class="mname" href="/">{profile.name}</a>
</header>
<button type="button" class="sbdim" id="sbdim" aria-label="메뉴 닫기" hidden></button>
<aside class="sb" id="sb" aria-label="사이트 메뉴">
  <a class="who" href="/">
    <span class="nm">{profile.name}</span>
    <span class="rl">{profile.title}</span>
  </a>
  <nav class="menu">
    <a class="top1" href="/">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h5v-6h4v6h5V9.5"/></svg>
      <span>Home</span>
    </a>

    <details open={section === 'reviews'}>
      <summary class={`top1${section === 'reviews' ? ' sec' : ''}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 6-6 6 6 6M16 6l6 6-6 6"/></svg>
        <span>코드 리뷰</span><span class="chev" aria-hidden="true"></span>
      </summary>
      <ul>
        {projects.map((p) => (
          <li>
            <a class={`cat${section === 'reviews' && active === p.key ? ' on' : ''}`} href={`/reviews/${p.key}/`} aria-current={section === 'reviews' && active === p.key && !current ? 'page' : undefined}>
              <span>{p.name}</span><span class="cnt">{reviews.filter((r) => r.data.project === p.key).length}</span>
            </a>
            {section === 'reviews' && active === p.key && posts.length > 0 && (
              <ol class="posts">
                {posts.map((x) => <li><a class={`post${x.href === current ? ' cur' : ''}`} href={x.href} aria-current={x.href === current ? 'page' : undefined}>{x.title}</a></li>)}
              </ol>
            )}
          </li>
        ))}
      </ul>
    </details>

    <details open={section === 'notes'}>
      <summary class={`top1${section === 'notes' ? ' sec' : ''}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5V5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2.5Z"/><path d="M20 19v3H6"/></svg>
        <span>학습 노트</span><span class="chev" aria-hidden="true"></span>
      </summary>
      <ul>
        <li><a class={`cat${section === 'notes' && !active ? ' on' : ''}`} href="/notes/" aria-current={section === 'notes' && !active ? 'page' : undefined}><span>전체</span><span class="cnt">{notes.length}</span></a></li>
      </ul>
      {groups.map((g) => (
        <>
          <span class="gt">{g}</span>
          <ul>
            {noteSeries.filter((s) => s.group === g).map((s) => (
              <li>
                <a class={`cat${section === 'notes' && active === s.key ? ' on' : ''}`} href={`/notes/${s.key}/`} aria-current={section === 'notes' && active === s.key && !current ? 'page' : undefined}>
                  <span>{s.name}</span><span class="cnt">{notes.filter((n) => n.data.series === s.key).length}</span>
                </a>
                {section === 'notes' && active === s.key && posts.length > 0 && (
                  <ol class="posts">
                    {posts.map((x) => <li><a class={`post${x.href === current ? ' cur' : ''}`} href={x.href} aria-current={x.href === current ? 'page' : undefined}>{x.title}</a></li>)}
                  </ol>
                )}
              </li>
            ))}
          </ul>
        </>
      ))}
    </details>
  </nav>
</aside>

<script>
  const sb = document.getElementById('sb')!;
  const openBtn = document.getElementById('sbopen')!;
  const dim = document.getElementById('sbdim')!;
  const set = (o: boolean) => { sb.classList.toggle('open', o); dim.hidden = !o; openBtn.setAttribute('aria-expanded', String(o)); };
  openBtn.addEventListener('click', () => set(true));
  dim.addEventListener('click', () => set(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  // 글 목록은 따로 스크롤되는 상자: 지금 글을 가운데로, 사이드바 자체는 강조된 카테고리가 보이게
  const place = () => {
    const box = sb.querySelector<HTMLElement>('.posts');
    const cur = sb.querySelector<HTMLElement>('.post.cur');
    if (box && cur) box.scrollTop = cur.offsetTop - box.clientHeight / 2 + cur.offsetHeight / 2;
    const cat = sb.querySelector<HTMLElement>('.cat.on');
    if (cat && cat.offsetTop > sb.clientHeight - 200) sb.scrollTop = cat.offsetTop - 120;
  };
  place();
  openBtn.addEventListener('click', place);
</script>

<style>
  .sb { position: fixed; left: 0; top: 0; bottom: 0; z-index: 20; width: 248px; box-sizing: border-box; padding: 28px 12px 40px; overflow-y: auto; background: #0B182C; border-right: 1px solid #1E3150; display: flex; flex-direction: column; gap: 22px; scrollbar-width: thin; scrollbar-color: #24385A transparent; }
  .who { display: flex; flex-direction: column; gap: 2px; padding: 0 10px; text-decoration: none; }
  .nm { font-size: 19px; font-weight: 700; color: #F4F6F9; letter-spacing: -0.01em; }
  .rl { font-size: 12.5px; color: #A3ADBF; line-height: 1.5; }
  .who:hover .nm { color: #7FB2FF; }
  .menu { display: flex; flex-direction: column; gap: 4px; }
  .top1 { display: flex; align-items: center; gap: 10px; min-height: 40px; padding: 0 10px; border-radius: 8px; font-size: 14.5px; font-weight: 600; color: #E4E8EF; text-decoration: none; cursor: pointer; list-style: none; }
  .top1::-webkit-details-marker { display: none; }
  .top1:hover { background: rgba(127,178,255,0.08); color: #F4F6F9; }
  .top1.sec { color: #7FB2FF; }
  .top1 svg { flex: none; }
  .chev { margin-left: auto; width: 7px; height: 7px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(-45deg); opacity: 0.6; transition: transform .15s; }
  details[open] > summary .chev { transform: rotate(45deg); }
  details ul { margin: 2px 0 6px; padding: 0 0 0 16px; list-style: none; display: flex; flex-direction: column; gap: 1px; }
  .gt { display: block; margin: 8px 0 2px 26px; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; color: #8A95A8; }
  .cat { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 34px; padding: 0 10px; border-radius: 6px; border-left: 2px solid transparent; font-size: 13.5px; font-weight: 500; color: #CDD5E1; text-decoration: none; }
  .cat:hover { background: rgba(127,178,255,0.06); color: #F4F6F9; }
  .cat.on { background: rgba(127,178,255,0.14); border-left-color: #7FB2FF; color: #7FB2FF; font-weight: 600; }
  .cnt { font-size: 11.5px; color: #8A95A8; }
  .cat.on .cnt { color: #7FB2FF; }
  .posts { position: relative; max-height: 46vh; overflow-y: auto; scrollbar-width: thin; scrollbar-color: #24385A transparent; margin: 4px 0 8px 10px; padding: 0 0 0 8px; list-style: none; border-left: 1px solid #24385A; display: flex; flex-direction: column; gap: 1px; }
  .post { display: block; padding: 5px 8px; border-radius: 6px; font-size: 12.5px; line-height: 1.45; color: #B0B9C8; text-decoration: none; }
  .post:hover { color: #F4F6F9; background: rgba(127,178,255,0.06); }
  .post.cur { color: #F4F6F9; font-weight: 600; background: rgba(127,178,255,0.1); box-shadow: inset 2px 0 0 #7FB2FF; }
  .mbar, .sbdim { display: none; }
  @media (max-width: 1023px) {
    .sb { transform: translateX(-100%); transition: transform .2s; width: 280px; box-shadow: 8px 0 30px rgba(0,0,0,0.4); }
    .sb.open { transform: none; }
    .mbar { display: flex; align-items: center; gap: 8px; position: sticky; top: 0; z-index: 17; height: 56px; padding: 0 8px; box-sizing: border-box; background: rgba(11,24,44,0.94); backdrop-filter: blur(8px); border-bottom: 1px solid #1E3150; }
    .sbopen { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; border-radius: 8px; background: transparent; color: #F4F6F9; cursor: pointer; }
    .sbopen:hover { background: rgba(127,178,255,0.08); }
    .mname { font-size: 16px; font-weight: 700; color: #F4F6F9; text-decoration: none; }
    .sbdim:not([hidden]) { display: block; position: fixed; inset: 0; z-index: 18; border: 0; background: rgba(0,0,0,0.5); }
  }
  @media (prefers-reduced-motion: reduce) { .sb, .chev { transition: none; } }
</style>
